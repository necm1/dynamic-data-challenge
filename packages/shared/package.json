{
    "name": "@repo/shared",
    "version": "0.0.0",
    "type": "commonjs",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc --watch -p tsconfig.build.json"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "typescript": "latest"
    }
}